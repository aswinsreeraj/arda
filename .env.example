# ARDA Local Development Environment Configuration
# Copy this file to .env: cp .env.example .env

# PostgreSQL Configuration
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=arda
POSTGRES_USER=arda_user
POSTGRES_PASSWORD=arda_password

# Database Connection URL (for local tools and applications)
DATABASE_URL=postgres://arda_user:arda_password@127.0.0.1:5432/arda?sslmode=disable
