# ARDA Local Development Environment Configuration
# Copy this file to .env: cp .env.example .env

# PostgreSQL Configuration
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=arda
POSTGRES_USER=arda_user
POSTGRES_PASSWORD=arda_password

# Database Connection URL (for local tools and applications)
DATABASE_URL=postgres://arda_user:arda_password@127.0.0.1:5432/arda?sslmode=disable

# HashiCorp Vault Configuration (Local Development)
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=root
VAULT_MOUNT=secret
VAULT_TIMEOUT=5s

# Temporal Configuration (Local Development)
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=arda-v1-task-queue
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233


